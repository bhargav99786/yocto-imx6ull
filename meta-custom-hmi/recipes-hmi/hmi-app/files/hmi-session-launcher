#!/bin/sh
# MarknStamp HMI Session Launcher
# Decouples systemd service from the application binary.

CONF="/etc/hmi-session.conf"
if [ -f "$CONF" ]; then
    . "$CONF"
fi

# Fallback defaults
APP_EXEC="${APP_EXEC:-/opt/hmi/bin/app}"
APP_PLATFORM="${APP_PLATFORM:-linuxfb:fb=/dev/fb0}"

# Ensure font directories and symlinks are set up for Qt
export QT_QPA_FONTDIR="${QT_QPA_FONTDIR:-/usr/share/fonts/ttf}"
if [ ! -d /usr/lib/fonts ]; then
    if [ -d /usr/share/fonts/ttf ]; then
        mkdir -p /usr/lib
        ln -sf /usr/share/fonts/ttf /usr/lib/fonts
    elif [ -d /usr/share/fonts/truetype ]; then
        mkdir -p /usr/lib
        ln -sf /usr/share/fonts/truetype /usr/lib/fonts
    fi
fi

# Ensure pointercal exists for tslib
if [ ! -f /etc/pointercal ]; then
    echo "0 -111848 67108864 -38400 0 39321600 65536" > /etc/pointercal
fi

# If configured binary does not exist or is not executable, fall back to default demo
if [ ! -x "$APP_EXEC" ]; then
    echo "[hmi-session-launcher] Warning: $APP_EXEC not found or not executable. Falling back to /usr/bin/hmi-app" >&2
    APP_EXEC="/usr/bin/hmi-app"
fi

# Export Qt Platform & Generic Plugin configurations
export QT_QPA_PLATFORM="$APP_PLATFORM"
if [ -n "$APP_EXTRA_ENV" ]; then
    export $APP_EXTRA_ENV
fi
export QT_QPA_FB_NO_LIBINPUT=1

# Ensure framebuffer is unblanked and backlight is turned on
echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true
for b in /sys/class/backlight/*; do
    [ -d "$b" ] && echo 7 > "$b/brightness" 2>/dev/null && echo 0 > "$b/bl_power" 2>/dev/null || true
done

echo "[hmi-session-launcher] Starting: $APP_EXEC $APP_ARGS"
exec "$APP_EXEC" $APP_ARGS
