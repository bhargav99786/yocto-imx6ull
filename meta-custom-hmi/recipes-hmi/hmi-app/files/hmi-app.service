[Unit]
Description=Fast-Boot Custom Qt 5.15 HMI Application
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-modules-load.service
Before=multi-user.target

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=linuxfb
Environment=QT_QPA_GENERIC_PLUGINS=evdevtouch:/dev/input/event0
ExecStart=/opt/hmi/hmi-app
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
