[Unit]
Description=MarknStamp HMI Application Session
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-modules-load.service boot-splash.service
Before=multi-user.target

[Service]
Type=simple
EnvironmentFile=-/etc/hmi-session.conf
ExecStart=/usr/bin/hmi-session-launcher
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
