[Unit]
Description=Fast-Boot Custom Qt 5.15 HMI Desktop Application
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-modules-load.service
Before=multi-user.target

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
Environment=QT_QPA_GENERIC_PLUGINS=evdevtouch:/dev/input/touchscreen0
Environment=QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/touchscreen0
Environment=QT_QPA_FB_NO_LIBINPUT=1
ExecStartPre=/bin/sh -c 'echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true; for b in /sys/class/backlight/*; do [ -d "$b" ] && echo 7 > "$b/brightness" 2>/dev/null && echo 0 > "$b/bl_power" 2>/dev/null || true; done'
ExecStart=/usr/bin/hmi-app
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
