+/**
+ * gtp_power_switch - power switch .
+ * @on: 1-switch on, 0-switch off.
+ * return: 0-succeed, -1-faileds
+ */
+static int gtp_power_switch(struct i2c_client *client, int on)
+{
+	static struct regulator *vdd_ana;
+	static struct regulator *vcc_i2c;
+	int ret = 0;
+	
+	if (!vdd_ana) {
+		vdd_ana = devm_regulator_get_optional(&client->dev, "vdd_ana");
+		if (IS_ERR(vdd_ana)) {
+			vdd_ana = NULL;
+		}
+	}
+
+	if (!vcc_i2c) {
+		vcc_i2c = devm_regulator_get_optional(&client->dev, "vcc_i2c");
+		if (IS_ERR(vcc_i2c)) {
+			vcc_i2c = NULL;
+		}
+	}
+
+	if (on) {
+		GTP_DEBUG("GTP power on.");
+		if (vdd_ana)
+			ret = regulator_enable(vdd_ana);
+		udelay(2);
+		if (vcc_i2c)
+			ret = regulator_enable(vcc_i2c);
+	} else {
+		GTP_DEBUG("GTP power off.");
+		if (vcc_i2c)
+			ret = regulator_disable(vcc_i2c);
+		udelay(2);
+		if (vdd_ana)
+			ret = regulator_disable(vdd_ana);
+	}
+	return 0;
+}
