+/* 
+ * Devices Tree support, 
+*/
+#ifdef GTP_CONFIG_OF
+/**
+ * gtp_parse_dt - parse platform infomation form devices tree.
+ */
+static void gtp_parse_dt(struct goodix_ts_data *ts, struct device *dev)
+{
+	struct device_node *np = dev->of_node;
+	u32 val;
+
+	gtp_int_gpio = of_get_named_gpio(np, "goodix,irq-gpio", 0);
+	if (!gpio_is_valid(gtp_int_gpio))
+		gtp_int_gpio = of_get_named_gpio(np, "irq-gpios", 0);
+
+	gtp_rst_gpio = of_get_named_gpio(np, "goodix,rst-gpio", 0);
+	if (!gpio_is_valid(gtp_rst_gpio))
+		gtp_rst_gpio = of_get_named_gpio(np, "reset-gpios", 0);
+
+	if (of_property_read_u32(np, "touchscreen-size-x", &val) == 0)
+		ts->abs_x_max = val;
+	else
+		ts->abs_x_max = 1024;
+
+	if (of_property_read_u32(np, "touchscreen-size-y", &val) == 0)
+		ts->abs_y_max = val;
+	else
+		ts->abs_y_max = 600;
+
+	ts->invert_x = of_property_read_bool(np, "touchscreen-inverted-x");
+	ts->invert_y = of_property_read_bool(np, "touchscreen-inverted-y");
+	ts->swap_x2y = of_property_read_bool(np, "touchscreen-swapped-x-y");
+}
+
+/**
+ * gtp_parse_dt_cfg - parse config data from devices tree.
+ * @dev: device that this driver attached.
+ * @cfg: pointer of the config array.
+ * @cfg_len: pointer of the config length.
+ * @sid: sensor id.
+ * Return: 0-succeed, -1-faileds
+ */
+int gtp_parse_dt_cfg(struct device *dev, u8 *cfg, int *cfg_len, u8 sid)
+{
+	struct device_node *np = dev->of_node;
+	struct property *prop;
+	char cfg_name[18];
+
+	snprintf(cfg_name, sizeof(cfg_name), "goodix,cfg-group%d", sid);
+	prop = of_find_property(np, cfg_name, cfg_len);
+	if (!prop || !prop->value || *cfg_len == 0 || *cfg_len > GTP_CONFIG_MAX_LENGTH) {
+		prop = of_find_property(np, "goodix,cfg-group0", cfg_len);
+	}
+	if (!prop || !prop->value || *cfg_len == 0 || *cfg_len > GTP_CONFIG_MAX_LENGTH) {
+		return -1;/* failed */
+	} else {
+		memcpy(cfg, prop->value, *cfg_len);
+		return 0;
+	}
+}
