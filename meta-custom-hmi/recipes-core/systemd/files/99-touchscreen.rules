# Touchscreen calibration matrix for 1024x600 Goodix display
# Aligns 90-degree rotated touch sensor with physical display coordinates:
# X_screen = Y_touch, Y_screen = 1 - X_touch
ACTION=="add|change", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 1 0 0"
